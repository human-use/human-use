{
  "$schema": "https://developers.cloudflare.com/workers/configuration/configuration-schema.json",
  "name": "human-use-bot",
  "main": "worker.mjs",
  "compatibility_date": "2026-04-08",
  "durable_objects": {
    "bindings": [{ "name": "BOT", "class_name": "Bot" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bot"] }]
}
