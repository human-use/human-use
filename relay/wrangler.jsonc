{
  "$schema": "https://developers.cloudflare.com/workers/configuration/configuration-schema.json",
  "name": "human-use-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-04-08",
  "assets": {
    "directory": "../assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "version_metadata": { "binding": "VERSION" },
  "durable_objects": {
    "bindings": [{ "name": "CHANNELS", "class_name": "Channel" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Channel"] }]
}
